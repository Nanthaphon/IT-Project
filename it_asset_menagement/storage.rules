rules_version = '2';

// Firebase Storage rules — สำหรับรูปประเมินสภาพอุปกรณ์
// อนุญาตให้ผู้ที่ login แล้วอ่านและเขียนได้ในโฟลเดอร์ที่กำหนด
service firebase.storage {
  match /b/{bucket}/o {

    // รูปประเมินสภาพ 6 จุด (ตัวเครื่อง, จอ, คีย์บอร์ด ฯลฯ)
    match /condition-photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024   // สูงสุด 5MB/ไฟล์
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // รูปประเมิน 100 คะแนน + slot 6 ทิศ
    match /assessment-photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // ปฏิเสธทุก path อื่น (default deny)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
